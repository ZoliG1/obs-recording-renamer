{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Recording Renamer",
  "Version": "1.2.0.0",
  "Author": "ZoliG1",
  "Description": "Buttons that add or remove words in the OBS Recording Renamer window, or delete the recording.",
  "Category": "Recording Renamer",
  "CategoryIcon": "imgs/category",
  "Icon": "imgs/plugin",
  "URL": "https://github.com/ZoliG1/obs-recording-renamer",
  "UUID": "com.zolig1.recordingrenamer",
  "SDKVersion": 2,
  "CodePath": "bin/plugin.js",
  "Nodejs": {
    "Version": "20"
  },
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "Actions": [
    {
      "UUID": "com.zolig1.recordingrenamer.addword",
      "Name": "Add word",
      "Tooltip": "Adds a word after the player name in the OBS rename window",
      "Icon": "imgs/actions/addword/icon",
      "PropertyInspectorPath": "ui/add-word.html",
      "SupportedInMultiActions": true,
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/addword/key",
          "TitleAlignment": "bottom",
          "FontSize": 14,
          "ShowTitle": true
        }
      ]
    },
    {
      "UUID": "com.zolig1.recordingrenamer.removeword",
      "Name": "Remove last word",
      "Tooltip": "Removes the last word from the name in the OBS rename window",
      "Icon": "imgs/actions/removeword/icon",
      "PropertyInspectorPath": "ui/add-word.html",
      "SupportedInMultiActions": true,
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/removeword/key",
          "TitleAlignment": "bottom",
          "FontSize": 12,
          "ShowTitle": true
        }
      ]
    },
    {
      "UUID": "com.zolig1.recordingrenamer.delete",
      "Name": "Delete recording",
      "Tooltip": "Moves the recording in the OBS rename window to the Recycle Bin (no confirmation). Does nothing while recording.",
      "Icon": "imgs/actions/delete/icon",
      "PropertyInspectorPath": "ui/add-word.html",
      "SupportedInMultiActions": true,
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/delete/key",
          "TitleAlignment": "bottom",
          "FontSize": 12,
          "ShowTitle": true
        }
      ]
    }
  ]
}
